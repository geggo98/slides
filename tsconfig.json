{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "customConditions": ["browser"],
    "types": ["vitest/globals", "vite/client", "bun"],
    "paths": {
      "@shared/*": ["./shared/*"],
      "@slidev/client": ["./shared/types/slidev-client.d.ts"],
      "@slidev/client/builtin/Mermaid.vue": [
        "./shared/types/slidev-mermaid.d.ts"
      ],
      "@slidev/client/setup/shiki.ts": ["./shared/types/slidev-shiki.d.ts"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "shared/**/*.vue",
    "deploy/**/*.ts",
    "*/components/**/*.ts",
    "*/components/**/*.vue",
    "*/layouts/**/*.vue",
    "*/setup/**/*.ts",
    "*/data/**/*.ts",
    "*/vite.config.ts",
    "playwright-tests/anatomy-agent-sim.ts",
    "playwright-tests/anatomy-auto-classifier.ts",
    "playwright-tests/anatomy-cost-estimate.ts",
    "playwright-tests/breakeven-sync-qa.ts",
    "playwright-tests/bun-bonus-popups.ts",
    "playwright-tests/check-rnext-map-cvd.ts",
    "playwright-tests/check-rnext-map.ts",
    "playwright-tests/click-states.ts",
    "playwright-tests/codex-tui-qa.ts",
    "playwright-tests/cvd-check.ts",
    "playwright-tests/cvd-core.ts",
    "playwright-tests/font-metrics.ts",
    "playwright-tests/harness-chart-qa.ts",
    "playwright-tests/harness-review-probe3.ts",
    "playwright-tests/label-box-check.ts",
    "playwright-tests/legend-width-check.ts",
    "playwright-tests/lightning-theme-check.ts",
    "playwright-tests/mr-crosshair-qa.ts",
    "playwright-tests/pareto-boxes.ts",
    "playwright-tests/pareto-label-qa.ts",
    "playwright-tests/prettier-render-neutral.ts",
    "playwright-tests/smoke-diagnose.ts",
    "playwright-tests/smoke-mm1-burst-shed.ts",
    "playwright-tests/smoke-mmc-burst-shed.ts",
    "playwright-tests/smoke-predict-first.ts",
    "playwright-tests/smoke-rabbit-queue.ts",
    "playwright-tests/smoke-retry-storm.ts",
    "playwright-tests/smoke-sentry-compare.ts",
    "playwright-tests/sources-popover-context.ts",
    "playwright-tests/spa-deep-link-check.ts",
    "playwright-tests/sweep-svg-fonts.ts",
    "playwright-tests/v1-bonus-qa.ts",
    "playwright-tests/verify-deploy.ts",
    "playwright-tests/zstd-delta-built-check.ts",
    "playwright-tests/zstd-delta-interactive-check.ts",
    "playwright-tests/zstd-delta-shots.ts"
  ]
}
